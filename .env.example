# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/messenger_ai"

# Any long random string. It signs the login tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: lets Sparky answer with Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Optional
FRONTEND_URL="http://localhost:3000"
PORT=4000
