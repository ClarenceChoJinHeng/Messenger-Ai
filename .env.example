# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/messenger_ai"

# Any long random string. It signs the login tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# Any long random string. Encrypts messages and uploaded files.
# Keep it safe: if you lose or change it, old messages can no longer be read.
MESSAGE_ENCRYPTION_KEY="change-me-to-another-long-random-string"

# Email (for confirming email/password changes). Leave SMTP_HOST empty in development:
# the emails are then printed in the backend terminal instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Messenger AI <no-reply@example.com>"

# Optional: lets Sparky answer with Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Optional
FRONTEND_URL="http://localhost:3000"
PORT=4000

# --- Only needed when hosting (see DEPLOY.md) ---
# Hosted MySQL with encryption: end DATABASE_URL with ?sslaccept=accept_invalid_certs
# Optional: the database's CA certificate (PEM text) so the server's identity is checked too
DATABASE_CA_CERT=""
# "database" keeps uploads in MySQL instead of the uploads/ folder (free hosts wipe their disk)
FILE_STORAGE=disk
